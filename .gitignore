
# --- agent-env-setup (universal framework) ---
.env
.env.*
tmp/
__pycache__/
agent-env-setup-handover/
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
